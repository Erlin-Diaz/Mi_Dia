// Reglas de seguridad de Firestore para "Tu día".
//
// MODELO DE SEGURIDAD: esta app no tiene login. El "código de
// sincronización" (una cadena aleatoria de 10 caracteres, generada en el
// dispositivo y mostrada en la fila de sincronización) funciona como una
// contraseña compartida: cualquiera que la conozca puede leer y escribir
// esos datos. Es un modelo deliberadamente simple para una app personal
// de uso familiar, no apto para datos sensibles.
//
// CÓMO APLICAR ESTE ARCHIVO (no se puede desplegar automáticamente desde
// acá, hace falta hacerlo manualmente una vez):
//   Opción A — Consola de Firebase:
//     Firebase Console → tu proyecto → Firestore Database → pestaña
//     "Reglas" → pegar este contenido → "Publicar".
//   Opción B — Firebase CLI (si la tenés instalada):
//     firebase deploy --only firestore:rules
//
// SOBRE "get" Y "list":
//   El traslado automático de tareas pendientes busca el día más
//   reciente anterior a hoy con lecturas directas por fecha (getDoc),
//   así que en la práctica solo necesita permiso de "get". Se deja
//   también "list" habilitado (no hace daño con este modelo de
//   seguridad tan abierto) por si algo a futuro necesita consultar la
//   colección completa. Si ya aplicaste una versión anterior de este
//   archivo con "get, list", no hace falta volver a aplicarlo: sigue
//   siendo válida.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /planners/{code}/days/{date} {
      allow get, list: if true;
      allow write: if true;
    }
    // Lista "Algún día": un único documento ("list") por código, con las
    // tareas que no están atadas a un día en particular.
    match /planners/{code}/someday/{doc} {
      allow get, list: if true;
      allow write: if true;
    }
  }
}
